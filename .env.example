# QR Guardian Environment Variables

# Environment: development | production
ENVIRONMENT=development

# Google Safe Browsing API Key (required for threat detection)
# No mock mode — if not set, Safe Browsing check is skipped (treated as safe)
GOOGLE_SAFE_BROWSING_API_KEY=

# Claude API Key (optional — enables AI-powered summary and action guidelines)
# Get your key at https://console.anthropic.com/
CLAUDE_API_KEY=

# Backend settings
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]
